{
  "name": "orbitq-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:react": "pnpm --filter @orbitq/react dev",
    "dev:vue": "pnpm --filter @orbitq/vue dev",
    "build:react": "pnpm --filter @orbitq/react build",
    "build:vue": "pnpm --filter @orbitq/vue build",
    "format": "oxfmt format apps/react/src apps/vue/src shared",
    "lint": "oxlint apps/react/src apps/vue/src shared/graphql/src",
    "typecheck": "pnpm --filter @orbitq/react typecheck && pnpm --filter @orbitq/vue typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": "oxfmt format"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.0",
    "happy-dom": "^18.0.0",
    "lint-staged": "^17.0.2",
    "oxfmt": "^0.48.0",
    "oxlint": "^0.16.6",
    "simple-git-hooks": "^2.13.1",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "xstate": "^5.31.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "simple-git-hooks",
      "vue-demi"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@vue/apollo-composable>@apollo/client": "3 || 4"
      }
    }
  }
}
